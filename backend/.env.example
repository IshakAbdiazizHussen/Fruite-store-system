MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/?retryWrites=true&w=majority&appName=<app-name>
MONGODB_DB_NAME=fruit-store
MONGODB_ENABLE_LOCAL_FALLBACK=true
MONGODB_FALLBACK_URI=mongodb://127.0.0.1:27017/fruit-store
BACKEND_PORT=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:3001,https://127.0.0.1:3000
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_NAME=fruit_store_auth
AUTH_TOKEN_TTL_SECONDS=604800
OAUTH_STATE_COOKIE_NAME=fruit_store_oauth_state
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_FRONTEND_URL=http://localhost:3000
ADMIN_NAME=Fruit Store Admin
ADMIN_EMAIL=admin@fruitstore.com
ADMIN_PASSWORD=admin12345
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:5000/api/auth/apple/callback
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=admin@fruitstore.com
SMTP_FROM_NAME=Fruit Store Admin
